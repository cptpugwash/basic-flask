{
	"name": "basic-flask",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": ".."
	},
	"forwardPorts": [5000],
	"portsAttributes": {
		"5000": {
			"label": "Flask app",
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python"
			]
		}
	},
	"postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
	"remoteUser": "root"
}
